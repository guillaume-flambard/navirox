# Normalise line endings on the way in. A contributor on Windows should not be
# able to turn every file in a pull request into a whole-file diff.
* text=auto eol=lf

# Binary, and never to be touched by a text filter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.keystore binary
*.pbxproj binary

# Generated, so keep them out of language stats.
#
# The lockfile stays diffable on purpose. Its pins are the supply-chain record,
# so a `-diff` attribute here would hide the one change a reviewer has to see,
# which is the change that moved a version.
pnpm-lock.yaml linguist-generated=true
*.pbxproj linguist-generated=true
