{
  "name": "navirox",
  "version": "0.1.1",
  "description": "Public launcher for the Navirox web-to-native analysis command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "navirox": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@memolabs-apps/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
