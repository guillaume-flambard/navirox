{
  "name": "@memolabs-apps/runtime-symbiote",
  "version": "0.1.0",
  "description": "The Symbiote-backed implementation of the runtime seam. The only package allowed to import @symbiote-native/*.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./runtime.json": "./dist/runtime.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@memolabs-apps/runtime": "workspace:*",
    "@symbiote-native/components": "2.0.0",
    "@symbiote-native/engine": "0.5.0",
    "@symbiote-native/navigation": "4.0.1",
    "@symbiote-native/vue": "2.0.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keychain": "^10.0.0"
  },
  "peerDependencies": {
    "react-native": ">=0.86",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
