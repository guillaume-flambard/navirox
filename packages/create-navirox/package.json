{
  "name": "create-navirox",
  "version": "0.1.1",
  "description": "Scaffolder invoked by `npm create navirox`.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "create-navirox": "./dist/bin.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
