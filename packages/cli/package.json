{
  "name": "@navirox/cli",
  "version": "0.0.0",
  "description": "The `navirox` command line interface.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "navirox": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@navirox/compat": "workspace:*",
    "@navirox/doctor": "workspace:*",
    "@navirox/inspect": "workspace:*",
    "@navirox/migrate": "workspace:*",
    "@navirox/planner": "workspace:*",
    "@navirox/source": "workspace:*",
    "@navirox/source-angular": "workspace:*",
    "@navirox/source-nuxt": "workspace:*",
    "@navirox/source-react": "workspace:*",
    "@navirox/source-svelte": "workspace:*",
    "@navirox/source-sveltekit": "workspace:*",
    "@navirox/source-vue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
