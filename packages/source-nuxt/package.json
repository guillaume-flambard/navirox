{
  "name": "@memolabs-apps/source-nuxt",
  "version": "0.1.1",
  "description": "The Nuxt source adapter: detection, filesystem routes, layouts and composables, on top of the Vue adapter.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@memolabs-apps/graph": "workspace:*",
    "@memolabs-apps/source": "workspace:*",
    "@memolabs-apps/source-vue": "workspace:*",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
