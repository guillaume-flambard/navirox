{
  "name": "@memolabs-apps/target-angular",
  "version": "0.1.1",
  "description": "A deliberately narrow Angular template to native-view compiler for Navirox.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
