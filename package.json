{
  "name": "navirox-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Navirox — the native mobile stack for Vue teams.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node scripts/e2e-scaffold.mjs",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "syncpack lint --dependency-types prod,dev,peer",
    "deps:fix": "syncpack fix-mismatches --dependency-types prod,dev,peer",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "syncpack": "^15.3.3",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
