# Navirox links its own packages across the workspace while runtime-symbiote
# peers on react-native. That peer is satisfied by the app, not by the library,
# so an unmet peer during install is expected rather than an error.
strict-peer-dependencies=false

# Do not let pnpm auto-install the peers it finds. react-native is a peer of the
# renderer that runtime-symbiote wraps, and react-native-screens peers react;
# auto-installing either would pull roughly half a gigabyte of native host code
# into a monorepo whose tests run in plain Node and whose example apps are
# standalone npm projects. Peers the app genuinely needs are installed by the app.
auto-install-peers=false
